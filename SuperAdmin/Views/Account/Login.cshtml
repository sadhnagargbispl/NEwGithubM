@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<div>
    <h1>Sign in</h1>
    <p class="muted small">Super Admin for all companies and panels</p>
</div>
@if (TempData["Flash"] is string ok)
{
    <div class="flash ok" role="status">@ok</div>
}
<form method="post" class="stack" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label class="field">
        User name
        <input asp-for="UserName" class="input" autocomplete="username" autofocus />
        <span asp-validation-for="UserName" class="field-error"></span>
    </label>
    <label class="field">
        Password
        <input asp-for="Password" class="input" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </label>
    <button type="submit" class="btn block">Sign in</button>
</form>
